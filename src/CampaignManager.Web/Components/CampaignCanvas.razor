@using CampaignManager.Shared.Models
@using CampaignManager.Shared.DTOs

<div class="campaign-canvas-container">
    <div class="canvas-workflow">
        <div class="workflow-steps">
            @* Step 1: Basic Details *@
            <div class="workflow-step @GetStepClass(1)" @onclick="() => SelectStep(1)">
                <div class="step-icon @GetStepIconClass(1)">
                    <i class="bi bi-info-circle"></i>
                </div>
                <div class="step-content">
                    <h6>Basic Details</h6>
                    <small>Campaign name & channels</small>
                </div>
                @if (CompletedSteps.Contains(1))
                {
                    <div class="step-check">
                        <i class="bi bi-check-circle-fill text-success"></i>
                    </div>
                }
            </div>

            <div class="workflow-connector @GetConnectorClass(1)"></div>

            @* Step 2: Fields Definition *@
            <div class="workflow-step @GetStepClass(2)" @onclick="() => SelectStep(2)">
                <div class="step-icon @GetStepIconClass(2)">
                    <i class="bi bi-table"></i>
                </div>
                <div class="step-content">
                    <h6>Define Fields</h6>
                    <small>Input data structure</small>
                </div>
                @if (CompletedSteps.Contains(2))
                {
                    <div class="step-check">
                        <i class="bi bi-check-circle-fill text-success"></i>
                    </div>
                }
            </div>

            <div class="workflow-connector @GetConnectorClass(2)"></div>

            @* Step 3: API Configuration *@
            <div class="workflow-step @GetStepClass(3)" @onclick="() => SelectStep(3)">
                <div class="step-icon @GetStepIconClass(3)">
                    <i class="bi bi-gear"></i>
                </div>
                <div class="step-content">
                    <h6>Configure APIs</h6>
                    <small>Templates & integrations</small>
                </div>
                @if (CompletedSteps.Contains(3))
                {
                    <div class="step-check">
                        <i class="bi bi-check-circle-fill text-success"></i>
                    </div>
                }
            </div>

            <div class="workflow-connector @GetConnectorClass(3)"></div>

            @* Step 4: Strategy *@
            <div class="workflow-step @GetStepClass(4)" @onclick="() => SelectStep(4)">
                <div class="step-icon @GetStepIconClass(4)">
                    <i class="bi bi-graph-up"></i>
                </div>
                <div class="step-content">
                    <h6>Strategy</h6>
                    <small>Retry & scheduling</small>
                </div>
                @if (CompletedSteps.Contains(4))
                {
                    <div class="step-check">
                        <i class="bi bi-check-circle-fill text-success"></i>
                    </div>
                }
            </div>

            <div class="workflow-connector @GetConnectorClass(4)"></div>

            @* Step 5: Activation *@
            <div class="workflow-step @GetStepClass(5)" @onclick="() => SelectStep(5)">
                <div class="step-icon @GetStepIconClass(5)">
                    <i class="bi bi-rocket"></i>
                </div>
                <div class="step-content">
                    <h6>Activate</h6>
                    <small>Launch campaign</small>
                </div>
                @if (CompletedSteps.Contains(5))
                {
                    <div class="step-check">
                        <i class="bi bi-check-circle-fill text-success"></i>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="canvas-content">
        @ChildContent
    </div>
</div>

<style>
    .campaign-canvas-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        padding: 1rem;
    }

    .canvas-workflow {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 15px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }

    .workflow-steps {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .workflow-step {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
        background: white;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        flex: 1;
        min-width: 200px;
        max-width: 280px;
    }

    .workflow-step:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    }

    .workflow-step.active {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        transform: scale(1.05);
    }

    .workflow-step.completed {
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        color: white;
    }

    .step-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(102, 126, 234, 0.1);
        font-size: 1.5rem;
        color: #667eea;
        transition: all 0.3s ease;
    }

    .workflow-step.active .step-icon,
    .workflow-step.completed .step-icon {
        background: rgba(255, 255, 255, 0.2);
        color: white;
    }

    .step-content h6 {
        margin: 0;
        font-weight: 600;
        font-size: 1rem;
    }

    .step-content small {
        color: #666;
        font-size: 0.85rem;
    }

    .workflow-step.active .step-content small,
    .workflow-step.completed .step-content small {
        color: rgba(255, 255, 255, 0.9);
    }

    .step-check {
        position: absolute;
        top: -8px;
        right: -8px;
        font-size: 1.5rem;
    }

    .workflow-connector {
        flex: 0 0 30px;
        height: 3px;
        background: rgba(255, 255, 255, 0.3);
        position: relative;
        transition: all 0.3s ease;
    }

    .workflow-connector.completed {
        background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
    }

    .workflow-connector::after {
        content: '→';
        position: absolute;
        right: -10px;
        top: -12px;
        color: white;
        font-size: 1.5rem;
    }

    .canvas-content {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    @@media (max-width: 1200px) {
        .workflow-steps {
            flex-direction: column;
            align-items: stretch;
        }

        .workflow-step {
            max-width: 100%;
        }

        .workflow-connector {
            width: 3px;
            height: 30px;
            flex: 0 0 30px;
            margin: 0 auto;
        }

        .workflow-connector::after {
            content: '↓';
            right: -10px;
            top: 20px;
        }
    }
</style>

@code {
    [Parameter]
    public int CurrentStep { get; set; } = 1;

    [Parameter]
    public EventCallback<int> CurrentStepChanged { get; set; }

    [Parameter]
    public HashSet<int> CompletedSteps { get; set; } = new();

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string GetStepClass(int step)
    {
        if (step == CurrentStep) return "active";
        if (CompletedSteps.Contains(step)) return "completed";
        return "";
    }

    private string GetStepIconClass(int step)
    {
        if (step == CurrentStep || CompletedSteps.Contains(step)) return "active";
        return "";
    }

    private string GetConnectorClass(int step)
    {
        if (CompletedSteps.Contains(step) && CompletedSteps.Contains(step + 1)) return "completed";
        return "";
    }

    private async Task SelectStep(int step)
    {
        CurrentStep = step;
        await CurrentStepChanged.InvokeAsync(step);
    }
}
