@page "/campaigns/{CampaignId:guid}/design"
@attribute [Authorize(Roles = "SuperAdmin,SubAdmin,Supervisor")]
@inject IApiService ApiService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Design Campaign - Campaign Manager</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Design Campaign</h1>
    <button class="btn btn-outline-secondary" @onclick="GoBack">Back to Campaigns</button>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@successMessage
        <button type="button" class="btn-close" @onclick="ClearMessages"></button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@errorMessage
        <button type="button" class="btn-close" @onclick="ClearMessages"></button>
    </div>
}

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (campaign != null)
{
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Step 1: Basic Details</h5>
                    <span class="badge @GetStatusBadgeClass(campaign.Status)">@campaign.Status</span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Name:</strong> @campaign.Name</p>
                            <p><strong>Description:</strong> @(campaign.Description ?? "N/A")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Channels:</strong> @GetChannelsDisplay(campaign.Channels)</p>
                            <p><strong>Created:</strong> @campaign.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Step 2: Define Input Feed (Fields)</h5>
                    <button class="btn btn-sm btn-primary" @onclick="ShowAddFieldModal">Add Field</button>
                </div>
                <div class="card-body">
                    @if (campaign.Fields.Any())
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Field Name</th>
                                    <th>Display Name</th>
                                    <th>Type</th>
                                    <th>Required</th>
                                    <th>Order</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var field in campaign.Fields.OrderBy(f => f.DisplayOrder))
                                {
                                    <tr>
                                        <td>@field.FieldName</td>
                                        <td>@field.DisplayName</td>
                                        <td>@field.FieldType</td>
                                        <td>@(field.IsRequired ? "Yes" : "No")</td>
                                        <td>@field.DisplayOrder</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteField(field.Id)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No fields defined yet. Add fields to define the data structure for this campaign.</p>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Step 3: Configure API</h5>
                </div>
                <div class="card-body">
                    @* Email Configuration Section *@
                    @if (HasChannel(ChannelType.Email))
                    {
                        <div class="mb-4">
                            <h6 class="text-primary"><i class="bi bi-envelope"></i> Email Configuration (SendGrid)</h6>
                            <hr />
                            <EditForm Model="@apiConfig" OnValidSubmit="SaveApiConfig">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">SendGrid API Key</label>
                                        <InputText class="form-control" @bind-Value="apiConfig.SendGridApiKey" type="password" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">From Email</label>
                                        <InputText class="form-control" @bind-Value="apiConfig.SendGridFromEmail" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">From Name</label>
                                        <InputText class="form-control" @bind-Value="apiConfig.SendGridFromName" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Template ID (optional - use for pre-built templates)</label>
                                        <InputText class="form-control" @bind-Value="apiConfig.SendGridTemplateId" />
                                    </div>
                                </div>

                                @* Email Subject with Field Picker *@
                                <div class="mb-3">
                                    <label class="form-label">Email Subject</label>
                                    <div class="input-group">
                                        <InputText class="form-control" @bind-Value="apiConfig.EmailSubject" placeholder="Enter subject line. Use {{FieldName}} for dynamic fields" />
                                        <div class="dropdown">
                                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                Insert Field
                                            </button>
                                            <ul class="dropdown-menu">
                                                @foreach (var field in campaign.Fields)
                                                {
                                                    <li><a class="dropdown-item" href="javascript:void(0)" @onclick="() => InsertFieldToSubject(field.FieldName)">@field.DisplayName ({{@field.FieldName}})</a></li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                @* HTML Email Template Designer *@
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label mb-0">Email Template (HTML)</label>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn @(showHtmlEditor ? "btn-primary" : "btn-outline-primary")" @onclick="() => showHtmlEditor = true">
                                                Edit HTML
                                            </button>
                                            <button type="button" class="btn @(!showHtmlEditor ? "btn-primary" : "btn-outline-primary")" @onclick="() => showHtmlEditor = false">
                                                Preview
                                            </button>
                                        </div>
                                    </div>
                                    
                                    @* Field Picker Panel *@
                                    <div class="card mb-2 bg-light">
                                        <div class="card-body py-2">
                                            <small class="text-muted d-block mb-1">Click to insert dynamic field placeholders:</small>
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var field in campaign.Fields)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => InsertFieldToTemplate(field.FieldName)">
                                                        {{@field.FieldName}}
                                                    </button>
                                                }
                                                @if (!campaign.Fields.Any())
                                                {
                                                    <span class="text-muted">No fields defined. Add fields in Step 2 first.</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    @if (showHtmlEditor)
                                    {
                                        <InputTextArea class="form-control font-monospace" @bind-Value="apiConfig.EmailTemplateHtml" rows="15" 
                                                       placeholder="Enter your HTML email template here. Use {{FieldName}} for dynamic content." />
                                    }
                                    else
                                    {
                                        <div class="border rounded p-3 bg-white" style="min-height: 300px;">
                                            @if (!string.IsNullOrEmpty(apiConfig.EmailTemplateHtml))
                                            {
                                                @((MarkupString)GetPreviewHtml())
                                            }
                                            else
                                            {
                                                <p class="text-muted">No template content yet. Switch to Edit HTML to create your email template.</p>
                                            }
                                        </div>
                                    }
                                    <small class="text-muted">Use {{FieldName}} syntax to insert dynamic lead data. Example: Hello {{FirstName}}, your account {{AccountNumber}} is ready.</small>
                                </div>

                                <button type="submit" class="btn btn-success">Save Email Configuration</button>
                            </EditForm>
                        </div>
                    }

                    @* Voice/Call Configuration Section *@
                    @if (HasChannel(ChannelType.Call))
                    {
                        <div class="mb-4">
                            <h6 class="text-success"><i class="bi bi-telephone"></i> Voice Configuration (WebEx)</h6>
                            <hr />
                            <EditForm Model="@apiConfig" OnValidSubmit="SaveApiConfig">
                                <div class="mb-3">
                                    <label class="form-label">API Endpoint</label>
                                    <InputText class="form-control" @bind-Value="apiConfig.WebExApiEndpoint" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Auth Token</label>
                                    <InputText class="form-control" @bind-Value="apiConfig.WebExAuthToken" type="password" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">CURL Command</label>
                                    <InputTextArea class="form-control font-monospace" @bind-Value="apiConfig.WebExCurl" rows="4" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Parameter Mappings (JSON)</label>
                                    <InputTextArea class="form-control font-monospace" @bind-Value="apiConfig.ParameterMappings" rows="6" 
                                                   placeholder='{"phone_number": "{{PhoneNumber}}", "customer_name": "{{FirstName}} {{LastName}}"}'/>
                                    <small class="text-muted">Map API parameters to lead fields using {{FieldName}} syntax</small>
                                </div>
                                <button type="submit" class="btn btn-success">Save Voice Configuration</button>
                            </EditForm>
                        </div>
                    }

                    @if (!HasChannel(ChannelType.Email) && !HasChannel(ChannelType.Call))
                    {
                        <p class="text-muted">Selected channels are coming soon!</p>
                    }
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Step 4: Define Strategy</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="@strategy" OnValidSubmit="SaveStrategy">
                        <div class="row">
                            @if (HasChannel(ChannelType.Email))
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Max Email Attempts</label>
                                    <InputNumber class="form-control" @bind-Value="strategy.MaxEmailAttempts" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Email Retry Interval (minutes)</label>
                                    <InputNumber class="form-control" @bind-Value="strategy.EmailRetryIntervalMinutes" />
                                </div>
                            }
                            @if (HasChannel(ChannelType.Call))
                            {
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Max Call Attempts</label>
                                    <InputNumber class="form-control" @bind-Value="strategy.MaxCallAttempts" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Call Retry Interval (minutes)</label>
                                    <InputNumber class="form-control" @bind-Value="strategy.CallRetryIntervalMinutes" />
                                </div>
                            }
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Working Days</label>
                                <InputText class="form-control" @bind-Value="strategy.WorkingDays" placeholder="Mon,Tue,Wed,Thu,Fri" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success">Save Strategy</button>
                    </EditForm>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button class="btn btn-primary me-2" @onclick="ActivateCampaign">Activate Campaign</button>
                <button class="btn btn-outline-primary" @onclick="GoToDataUpload">Upload Data</button>
            </div>
        </div>
    </div>
}

@if (showFieldModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Field</h5>
                    <button type="button" class="btn-close" @onclick="CloseFieldModal"></button>
                </div>
                <EditForm Model="@newField" OnValidSubmit="AddField">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Field Name (unique identifier)</label>
                            <InputText class="form-control" @bind-Value="newField.FieldName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Display Name</label>
                            <InputText class="form-control" @bind-Value="newField.DisplayName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Field Type</label>
                            <InputSelect class="form-select" @bind-Value="newField.FieldType">
                                <option value="@FieldType.String">String</option>
                                <option value="@FieldType.Number">Number</option>
                                <option value="@FieldType.Date">Date</option>
                                <option value="@FieldType.Boolean">Boolean</option>
                                <option value="@FieldType.Email">Email</option>
                                <option value="@FieldType.Phone">Phone</option>
                            </InputSelect>
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="newField.IsRequired" />
                            <label class="form-check-label">Required</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Display Order</label>
                            <InputNumber class="form-control" @bind-Value="newField.DisplayOrder" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseFieldModal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid CampaignId { get; set; }

    private CampaignDto? campaign;
    private UpdateApiConfigRequest apiConfig = new();
    private UpdateStrategyRequest strategy = new();
    private CreateCampaignFieldRequest newField = new();
    private bool isLoading = true;
    private bool showFieldModal = false;
    private bool showHtmlEditor = true;
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCampaign();
    }

    private async Task LoadCampaign()
    {
        isLoading = true;
        try
        {
            campaign = await ApiService.GetAsync<CampaignDto>($"campaigns/{CampaignId}");
            if (campaign?.ApiConfig != null)
            {
                apiConfig = new UpdateApiConfigRequest
                {
                    SendGridApiKey = campaign.ApiConfig.SendGridApiKey,
                    SendGridFromEmail = campaign.ApiConfig.SendGridFromEmail,
                    SendGridFromName = campaign.ApiConfig.SendGridFromName,
                    SendGridTemplateId = campaign.ApiConfig.SendGridTemplateId,
                    EmailTemplateHtml = campaign.ApiConfig.EmailTemplateHtml,
                    EmailSubject = campaign.ApiConfig.EmailSubject,
                    WebExApiEndpoint = campaign.ApiConfig.WebExApiEndpoint,
                    WebExAuthToken = campaign.ApiConfig.WebExAuthToken,
                    WebExCurl = campaign.ApiConfig.WebExCurl,
                    ParameterMappings = campaign.ApiConfig.ParameterMappings
                };
            }
            if (campaign?.Strategy != null)
            {
                strategy = new UpdateStrategyRequest
                {
                    MaxEmailAttempts = campaign.Strategy.MaxEmailAttempts,
                    MaxCallAttempts = campaign.Strategy.MaxCallAttempts,
                    EmailRetryIntervalMinutes = campaign.Strategy.EmailRetryIntervalMinutes,
                    CallRetryIntervalMinutes = campaign.Strategy.CallRetryIntervalMinutes,
                    WorkingDays = campaign.Strategy.WorkingDays
                };
            }
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearMessages()
    {
        successMessage = null;
        errorMessage = null;
    }

    private async Task ShowSuccessMessage(string message)
    {
        ClearMessages();
        successMessage = message;
        StateHasChanged();
        await Task.Delay(3000);
        successMessage = null;
        StateHasChanged();
    }

    private void ShowErrorMessage(string message)
    {
        ClearMessages();
        errorMessage = message;
        StateHasChanged();
    }

    private bool HasChannel(ChannelType channel)
    {
        return campaign != null && (campaign.Channels & channel) == channel;
    }

    private string GetChannelsDisplay(ChannelType channels)
    {
        var channelList = new List<string>();
        if ((channels & ChannelType.Email) == ChannelType.Email) channelList.Add("Email");
        if ((channels & ChannelType.Call) == ChannelType.Call) channelList.Add("Call");
        if ((channels & ChannelType.VoiceBot) == ChannelType.VoiceBot) channelList.Add("VoiceBot");
        if ((channels & ChannelType.WhatsApp) == ChannelType.WhatsApp) channelList.Add("WhatsApp");
        if ((channels & ChannelType.SMS) == ChannelType.SMS) channelList.Add("SMS");
        return channelList.Count > 0 ? string.Join(", ", channelList) : "None";
    }

    private void InsertFieldToSubject(string fieldName)
    {
        apiConfig.EmailSubject = (apiConfig.EmailSubject ?? "") + "{{" + fieldName + "}}";
    }

    private void InsertFieldToTemplate(string fieldName)
    {
        apiConfig.EmailTemplateHtml = (apiConfig.EmailTemplateHtml ?? "") + "{{" + fieldName + "}}";
    }

    private string GetPreviewHtml()
    {
        var html = apiConfig.EmailTemplateHtml ?? "";
        
        // Basic HTML sanitization - remove script tags and event handlers
        // Note: This is a preview for the template designer (admin users only)
        // For production email sending, proper sanitization should be done server-side
        html = System.Text.RegularExpressions.Regex.Replace(html, @"<script[^>]*>[\s\S]*?</script>", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\s*on\w+\s*=\s*""[^""]*""", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\s*on\w+\s*=\s*'[^']*'", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        
        // Replace field placeholders with sample values for preview
        if (campaign?.Fields != null)
        {
            foreach (var field in campaign.Fields)
            {
                var safeDisplayName = System.Net.WebUtility.HtmlEncode(field.DisplayName ?? field.FieldName);
                html = html.Replace("{{" + field.FieldName + "}}", $"<span class='badge bg-info'>[{safeDisplayName}]</span>");
            }
        }
        return html;
    }

    private void ShowAddFieldModal()
    {
        newField = new CreateCampaignFieldRequest { DisplayOrder = campaign?.Fields.Count ?? 0 };
        showFieldModal = true;
    }

    private void CloseFieldModal()
    {
        showFieldModal = false;
    }

    private async Task AddField()
    {
        var (result, error) = await ApiService.PostWithErrorAsync<ApiResponse<CampaignFieldDto>>($"campaigns/{CampaignId}/fields", newField);
        if (result?.Success == true)
        {
            showFieldModal = false;
            await LoadCampaign();
            _ = ShowSuccessMessage("Field added successfully!");
        }
        else
        {
            ShowErrorMessage(error ?? "Failed to add field");
        }
    }

    private async Task DeleteField(Guid fieldId)
    {
        var success = await ApiService.DeleteAsync($"campaigns/fields/{fieldId}");
        if (success)
        {
            await LoadCampaign();
            _ = ShowSuccessMessage("Field deleted successfully!");
        }
        else
        {
            ShowErrorMessage("Failed to delete field");
        }
    }

    private async Task SaveApiConfig()
    {
        var (result, error) = await ApiService.PutWithErrorAsync<ApiResponse<CampaignApiConfigDto>>($"campaigns/{CampaignId}/api-config", apiConfig);
        if (result?.Success == true)
        {
            _ = ShowSuccessMessage("API configuration saved successfully!");
        }
        else
        {
            ShowErrorMessage(error ?? "Failed to save API configuration");
        }
    }

    private async Task SaveStrategy()
    {
        var (result, error) = await ApiService.PutWithErrorAsync<ApiResponse<CampaignStrategyDto>>($"campaigns/{CampaignId}/strategy", strategy);
        if (result?.Success == true)
        {
            _ = ShowSuccessMessage("Strategy saved successfully!");
        }
        else
        {
            ShowErrorMessage(error ?? "Failed to save strategy");
        }
    }

    private async Task ActivateCampaign()
    {
        var update = new UpdateCampaignRequest { Status = CampaignStatus.Active };
        var (result, error) = await ApiService.PutWithErrorAsync<ApiResponse<CampaignDto>>($"campaigns/{CampaignId}", update);
        if (result?.Success == true)
        {
            await LoadCampaign();
            _ = ShowSuccessMessage("Campaign activated successfully!");
        }
        else
        {
            ShowErrorMessage(error ?? "Failed to activate campaign");
        }
    }

    private void GoToDataUpload()
    {
        Navigation.NavigateTo($"/campaigns/{CampaignId}/upload");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/campaigns");
    }

    private string GetStatusBadgeClass(CampaignStatus status) => status switch
    {
        CampaignStatus.Draft => "bg-secondary",
        CampaignStatus.Active => "bg-success",
        CampaignStatus.Paused => "bg-warning",
        CampaignStatus.Completed => "bg-info",
        CampaignStatus.Archived => "bg-dark",
        _ => "bg-secondary"
    };
}
