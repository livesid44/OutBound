@page "/campaigns"
@attribute [Authorize(Roles = "SuperAdmin,SubAdmin,Supervisor")]
@inject IApiService ApiService
@inject NavigationManager Navigation

<PageTitle>Campaigns - Campaign Manager</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Campaigns</h1>
    <button class="btn btn-primary" @onclick="ShowCreateModal">
        <span class="bi bi-plus"></span> New Campaign
    </button>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Channels</th>
                    <th>Status</th>
                    <th>Leads</th>
                    <th>Scheduler</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (campaigns?.Items != null)
                {
                    @foreach (var campaign in campaigns.Items)
                    {
                        <tr>
                            <td>@campaign.Name</td>
                            <td>@GetChannelsDisplay(campaign.Channels)</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(campaign.Status)">
                                    @campaign.Status
                                </span>
                            </td>
                            <td>@campaign.LeadCount</td>
                            <td>
                                <span class="badge @(campaign.IsSchedulerEnabled ? "bg-success" : "bg-secondary")">
                                    @(campaign.IsSchedulerEnabled ? "On" : "Off")
                                </span>
                            </td>
                            <td>@campaign.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewCampaign(campaign.Id)">
                                    View
                                </button>
                                <button class="btn btn-sm btn-outline-info" @onclick="() => DesignCampaign(campaign.Id)">
                                    Design
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (showCreateModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create Campaign</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@newCampaign" OnValidSubmit="CreateCampaign">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Campaign Name</label>
                            <InputText class="form-control" @bind-Value="newCampaign.Name" />
                            <ValidationMessage For="@(() => newCampaign.Name)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" @bind-Value="newCampaign.Description" rows="3" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Select Channels (Multiple Allowed)</label>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkEmail" 
                                               checked="@HasChannel(ChannelType.Email)" 
                                               @onchange="@(e => ToggleChannel(ChannelType.Email, (bool)e.Value!))" />
                                        <label class="form-check-label" for="chkEmail">
                                            <i class="bi bi-envelope"></i> Email
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkCall" 
                                               checked="@HasChannel(ChannelType.Call)" 
                                               @onchange="@(e => ToggleChannel(ChannelType.Call, (bool)e.Value!))" />
                                        <label class="form-check-label" for="chkCall">
                                            <i class="bi bi-telephone"></i> Call
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkVoiceBot" 
                                               checked="@HasChannel(ChannelType.VoiceBot)" 
                                               @onchange="@(e => ToggleChannel(ChannelType.VoiceBot, (bool)e.Value!))" />
                                        <label class="form-check-label" for="chkVoiceBot">
                                            <i class="bi bi-robot"></i> Voice Blast
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkWhatsApp" 
                                               checked="@HasChannel(ChannelType.WhatsApp)" 
                                               @onchange="@(e => ToggleChannel(ChannelType.WhatsApp, (bool)e.Value!))" />
                                        <label class="form-check-label" for="chkWhatsApp">
                                            <i class="bi bi-whatsapp"></i> WhatsApp
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="chkSMS" 
                                               checked="@HasChannel(ChannelType.SMS)" 
                                               @onchange="@(e => ToggleChannel(ChannelType.SMS, (bool)e.Value!))" />
                                        <label class="form-check-label" for="chkSMS">
                                            <i class="bi bi-chat-dots"></i> SMS
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isCreating">
                            @if (isCreating)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Create
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<CampaignDto>? campaigns;
    private bool isLoading = true;
    private bool showCreateModal = false;
    private bool isCreating = false;
    private CreateCampaignRequest newCampaign = new() { Channels = ChannelType.Email };

    protected override async Task OnInitializedAsync()
    {
        await LoadCampaigns();
    }

    private async Task LoadCampaigns()
    {
        isLoading = true;
        try
        {
            campaigns = await ApiService.GetAsync<PagedResult<CampaignDto>>("campaigns");
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        newCampaign = new CreateCampaignRequest { Channels = ChannelType.Email };
        showCreateModal = true;
    }

    private void CloseModal()
    {
        showCreateModal = false;
    }

    private bool HasChannel(ChannelType channel)
    {
        return (newCampaign.Channels & channel) == channel;
    }

    private void ToggleChannel(ChannelType channel, bool isChecked)
    {
        if (isChecked)
        {
            newCampaign.Channels |= channel;
        }
        else
        {
            newCampaign.Channels &= ~channel;
        }
    }

    private async Task CreateCampaign()
    {
        // Ensure at least one channel is selected
        if (newCampaign.Channels == ChannelType.None)
        {
            newCampaign.Channels = ChannelType.Email;
        }

        isCreating = true;
        try
        {
            var result = await ApiService.PostAsync<ApiResponse<CampaignDto>>("campaigns", newCampaign);
            if (result?.Success == true)
            {
                showCreateModal = false;
                await LoadCampaigns();
            }
        }
        catch { }
        finally
        {
            isCreating = false;
        }
    }

    private void ViewCampaign(Guid id)
    {
        Navigation.NavigateTo($"/campaigns/{id}");
    }

    private void DesignCampaign(Guid id)
    {
        Navigation.NavigateTo($"/campaigns/{id}/design");
    }

    private string GetChannelsDisplay(ChannelType channels)
    {
        var channelList = new List<string>();
        if ((channels & ChannelType.Email) == ChannelType.Email) channelList.Add("Email");
        if ((channels & ChannelType.Call) == ChannelType.Call) channelList.Add("Call");
        if ((channels & ChannelType.VoiceBot) == ChannelType.VoiceBot) channelList.Add("VoiceBot");
        if ((channels & ChannelType.WhatsApp) == ChannelType.WhatsApp) channelList.Add("WhatsApp");
        if ((channels & ChannelType.SMS) == ChannelType.SMS) channelList.Add("SMS");
        return channelList.Count > 0 ? string.Join(", ", channelList) : "None";
    }

    private string GetStatusBadgeClass(CampaignStatus status) => status switch
    {
        CampaignStatus.Draft => "bg-secondary",
        CampaignStatus.Active => "bg-success",
        CampaignStatus.Paused => "bg-warning",
        CampaignStatus.Completed => "bg-info",
        CampaignStatus.Archived => "bg-dark",
        _ => "bg-secondary"
    };
}
