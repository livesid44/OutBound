@page "/scheduler"
@attribute [Authorize(Roles = "SuperAdmin,SubAdmin,Supervisor")]
@inject IApiService ApiService

<PageTitle>Scheduler & Monitor - Campaign Manager</PageTitle>

<h1>Scheduler & Monitor</h1>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (campaigns?.Items != null)
{
    <div class="row">
        @foreach (var campaign in campaigns.Items)
        {
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@campaign.Name</h5>
                        <div>
                            <span class="badge @(campaign.SchedulerEnabled ? "bg-success" : "bg-secondary") me-2">
                                @(campaign.SchedulerEnabled ? "Scheduler On" : "Scheduler Off")
                            </span>
                            <button class="btn btn-sm @(campaign.SchedulerEnabled ? "btn-danger" : "btn-success")" 
                                    @onclick="() => ToggleScheduler(campaign.Id, !campaign.SchedulerEnabled)">
                                @(campaign.SchedulerEnabled ? "Turn Off" : "Turn On")
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        @{
                            var stats = campaignStats.FirstOrDefault(s => s.CampaignId == campaign.Id);
                        }
                        @if (stats != null)
                        {
                            <div class="row text-center">
                                <div class="col">
                                    <h6>Total</h6>
                                    <h4>@stats.TotalLeads</h4>
                                </div>
                                <div class="col">
                                    <h6>Queued</h6>
                                    <h4 class="text-warning">@stats.QueuedCount</h4>
                                </div>
                                <div class="col">
                                    <h6>Email Queue</h6>
                                    <h4 class="text-info">@stats.EmailPendingCount</h4>
                                </div>
                                <div class="col">
                                    <h6>Voice Queue</h6>
                                    <h4 class="text-primary">@stats.CallPendingCount</h4>
                                </div>
                            </div>
                            <hr />
                            <div class="row text-center">
                                <div class="col">
                                    <h6>Dialed</h6>
                                    <h4>@stats.DialedCount</h4>
                                </div>
                                <div class="col">
                                    <h6>Connected</h6>
                                    <h4 class="text-success">@stats.ConnectedCount</h4>
                                </div>
                                <div class="col">
                                    <h6>RPC</h6>
                                    <h4 class="text-success">@stats.RightPartyContactCount</h4>
                                </div>
                                <div class="col">
                                    <h6>Disposed</h6>
                                    <h4 class="text-info">@stats.DisposedCount</h4>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Loading stats...</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">No campaigns found.</div>
}

@code {
    private PagedResult<CampaignDto>? campaigns;
    private List<CampaignStatsDto> campaignStats = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            campaigns = await ApiService.GetAsync<PagedResult<CampaignDto>>("campaigns");
            
            if (campaigns?.Items != null)
            {
                foreach (var campaign in campaigns.Items)
                {
                    var stats = await ApiService.GetAsync<CampaignStatsDto>($"campaigns/{campaign.Id}/stats");
                    if (stats != null)
                    {
                        campaignStats.Add(stats);
                    }
                }
            }
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleScheduler(Guid campaignId, bool enable)
    {
        await ApiService.PostAsync<ApiResponse<bool>>($"campaigns/{campaignId}/scheduler/toggle?enable={enable}");
        await LoadData();
    }
}
