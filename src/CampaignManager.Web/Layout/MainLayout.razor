@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject IApiService ApiService
@inject NavigationManager Navigation
@using CampaignManager.Shared.DTOs
@using CampaignManager.Shared.Models

<AuthorizeView>
    <Authorized>
        <div class="dashboard">
            <!-- SIDEBAR -->
            <div class="sidebar">
                <div class="logo-area">
                    <img src="images/protonect_logo_white.png" alt="logo" class="logo">
                </div>
                <NavMenu />
            </div>

            <!-- MAIN PAGE -->
            <div class="main">
                <div class="dashboard_header d-flex justify-content-between align-items-center px-4">
                    <div class="d-flex align-items-center">
                        @if (_isSuperAdmin)
                        {
                            <div class="tenant-selector d-flex align-items-center">
                                <label class="me-2 secondarytextcolor">Tenant:</label>
                                <select class="form-select form-select-sm" style="width: 200px;"
                                        value="@_selectedProjectId" 
                                        @onchange="OnProjectChanged">
                                    <option value="">-- Select Tenant --</option>
                                    @if (_projects != null)
                                    {
                                        @foreach (var project in _projects)
                                        {
                                            <option value="@project.Id">@project.Name</option>
                                        }
                                    }
                                </select>
                                @if (!string.IsNullOrEmpty(_selectedProjectName))
                                {
                                    <span class="badge bg-success ms-2">@_selectedProjectName</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="me-3 secondarytextcolor">Welcome, @context.User.Identity?.Name</span>
                        <button class="btn btn-primary btn-sm" @onclick="Logout">Logout</button>
                    </div>
                </div>

                <div class="dashboard_body">
                    @if (_isSuperAdmin && string.IsNullOrEmpty(_selectedProjectId))
                    {
                        <div class="alert alert-warning">
                            <h5 class="alert-heading mb-2">Select a Tenant</h5>
                            <p class="mb-0">As a SuperAdmin, please select a tenant (project) from the dropdown above to perform tenant-specific actions.</p>
                        </div>
                    }
                    @Body
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<ProjectDto>? _projects;
    private string _selectedProjectId = "";
    private string? _selectedProjectName;
    private bool _isSuperAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserContext();
    }

    private async Task LoadUserContext()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user != null)
        {
            _isSuperAdmin = user.Role == UserRole.SuperAdmin;
            
            if (_isSuperAdmin)
            {
                // Load projects for SuperAdmin
                await LoadProjects();
                
                // Restore previously selected project
                var savedProjectId = await AuthService.GetSelectedProjectIdAsync();
                if (savedProjectId.HasValue)
                {
                    _selectedProjectId = savedProjectId.Value.ToString();
                    _selectedProjectName = await AuthService.GetSelectedProjectNameAsync();
                }
            }
        }
    }

    private async Task LoadProjects()
    {
        try
        {
            _projects = new List<ProjectDto>();
            var result = await ApiService.GetAsync<PagedResult<ProjectDto>>("projects?pageSize=100");
            if (result?.Items != null)
            {
                _projects = result.Items;
            }
        }
        catch
        {
            _projects = new List<ProjectDto>();
        }
        StateHasChanged();
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        var projectId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(projectId) && Guid.TryParse(projectId, out var guid))
        {
            _selectedProjectId = projectId;
            var project = _projects?.FirstOrDefault(p => p.Id == guid);
            _selectedProjectName = project?.Name ?? "";
            await AuthService.SetSelectedProjectAsync(guid, _selectedProjectName);
            
            // Refresh the current page to reload data with new tenant context
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        else
        {
            _selectedProjectId = "";
            _selectedProjectName = null;
            await AuthService.ClearSelectedProjectAsync();
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
