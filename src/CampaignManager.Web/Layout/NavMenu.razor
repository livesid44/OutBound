<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Campaign Manager</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <AuthorizeView Roles="SuperAdmin,SubAdmin,Supervisor,Agent">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="SuperAdmin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="projects">
                    <span class="bi bi-building-nav-menu" aria-hidden="true"></span> Projects
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="SuperAdmin,SubAdmin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="users">
                    <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Users
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="SuperAdmin,SubAdmin,Supervisor">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="campaigns">
                    <span class="bi bi-megaphone-nav-menu" aria-hidden="true"></span> Campaigns
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="SuperAdmin,SubAdmin,Supervisor">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="scheduler">
                    <span class="bi bi-calendar-nav-menu" aria-hidden="true"></span> Scheduler
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="SuperAdmin,SubAdmin,Supervisor">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reports">
                    <span class="bi bi-bar-chart-nav-menu" aria-hidden="true"></span> Reports
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Agent">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="agent">
                    <span class="bi bi-headset-nav-menu" aria-hidden="true"></span> Agent UI
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Supervisor">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="supervisor">
                    <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Supervisor
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
